# Test Environment Variables

# LLM Configuration
# Set locally in your shell or CI secret store. Do not commit real values.
# Select gemini (default), openai, or anthropic. Set only its API key.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Blank uses Gemini defaults. OpenAI/Anthropic require an explicit model ID.
# A comma-separated list enables quota fallback within the selected provider.
LLM_MODEL=
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_RETRIES=4
LLM_REQUEST_TIMEOUT=120
LLM_CACHE_ENABLED=true
LLM_CACHE_VERSION=v4
LLM_CACHE_DIR=.cache/llm
FORCE_REGENERATE=false
STRICT_GENERATION=false

# Environment Selection (staging, uat, production)
TEST_ENV=staging

# API Configuration
API_SECRET_KEY=your-api-key-here
STAGING_API_URL=https://api-staging.example.com
UAT_API_URL=https://api-uat.example.com
PROD_API_URL=https://api.example.com

# Web Application URLs
STAGING_BASE_URL=https://staging.example.com
UAT_BASE_URL=https://uat.example.com
PROD_BASE_URL=https://example.com

# Test User Credentials
TEST_USERNAME=test@example.com
TEST_PASSWORD=

# Browser Configuration
HEADLESS=true
SLOW_MO=0
TIMEOUT=30000

# Reporting and Debugging
GENERATE_REPORT=true
TAKE_SCREENSHOTS=true
RECORD_VIDEOS=false
ENABLE_TRACING=false
